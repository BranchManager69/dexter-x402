# HTTP port for the facilitator service
PORT=4070

# Pino log level
LOG_LEVEL=info

# Comma-separated list of networks this facilitator supports (e.g., solana,base)
# Production runs mainnet-only; keep this to mainnet chains you actually settle on.
FACILITATOR_NETWORKS=solana

# Required: Helius API key for Solana mainnet RPC
HELIUS_API_KEY=

# Required for Solana: base58-encoded secret key used as the fee payer when settling payments
SOLANA_PRIVATE_KEY=

# Required for Base settlements
# BASE_PRIVATE_KEY=

# Optional: override Base RPC (otherwise viem defaults apply)
# BASE_RPC_URL=

# Optional: restrict CORS origins (comma-separated)
# ALLOWED_ORIGINS=https://app.example.com
